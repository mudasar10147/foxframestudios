# Environment variables

# Public site URL (used for metadata, OG tags, sitemap, robots).
# On Vercel this can be left unset — it falls back to the project's
# production domain automatically. Set it to your custom domain once
# you have one (e.g. https://foxdevsstudio.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend API key (server-side only) — get one at https://resend.com/api-keys
RESEND_API_KEY=

# Contact form recipient
CONTACT_EMAIL=

# Neon Postgres connection string (server-side only). Added automatically when you
# connect a Neon database to the project in Vercel → Storage. Contact messages are
# saved here; the table is created on first use.
DATABASE_URL=

# Admin dashboard sign-in (server-side only). /admin/login checks these.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# At least 32 random characters, used to sign the admin session cookie.
# Generate one with: openssl rand -base64 48
ADMIN_SESSION_SECRET=
