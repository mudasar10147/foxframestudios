# Environment variables

# Public site URL (used for metadata, OG tags, sitemap, robots).
# On Vercel this can be left unset — it falls back to the project's
# production domain automatically. Set it to your custom domain once
# you have one (e.g. https://foxdevsstudio.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend API key (server-side only) — get one at https://resend.com/api-keys
RESEND_API_KEY=

# Contact form recipient
CONTACT_EMAIL=
